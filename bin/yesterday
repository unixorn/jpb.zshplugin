#!/usr/bin/env python3
"""Print yesterday's date.

Original source: https://github.com/ClarkGoble/Scripts/blob/master/yesterday.py

Testing:
    python3 bin/yesterday
    python3 bin/yesterday --format "%Y-%m-%d"
"""

import argparse
import datetime
import sys


def get_yesterday(fmt: str = "%m/%d/%Y") -> str:
    """Return yesterday's date as a formatted string.

    Args:
        fmt: strftime format string (default: %m/%d/%Y).

    Returns:
        Yesterday's date formatted according to fmt.
    """
    if not fmt:
        fmt = "%m/%d/%Y"
    today = datetime.datetime.now(tz=datetime.timezone.utc).astimezone().date()
    yesterday = today + datetime.timedelta(days=-1)
    return yesterday.strftime(fmt)


def main(argv: list[str] | None = None) -> int:
    """Print yesterday's date in the specified format.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(description="Print yesterday's date.")
    parser.add_argument(
        "--format",
        default="%m/%d/%Y",
        help="strftime format string (default: %%m/%%d/%%Y)",
    )
    args = parser.parse_args(argv)

    print(get_yesterday(fmt=args.format))
    return 0


if __name__ == "__main__":
    sys.exit(main())
