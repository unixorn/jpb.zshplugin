#!/usr/bin/env python3
"""Locate Python modules and packages by name.

A Python equivalent to 'which' for Python modules. For each argument,
lists all Python files and directories with that name found in sys.path.

Testing:
    python3 bin/whap --help
    python3 bin/whap os json sys
    python3 bin/whap requests  # third-party example
"""

import argparse
import importlib
import logging
import subprocess
import sys

_copyright = """
(c) J Alan Brogan 2013
    The source is released under the MIT license
    See http://jalanb.mit-license.org/ for more information
"""

logger = logging.getLogger(__name__)


def built_in(name: str) -> bool:
    """Return whether the given name is a built-in Python module.

    Args:
        name: Module name to check.

    Returns:
        True if the module is a built-in, False otherwise.
    """
    try:
        __import__(name)
    except ImportError:
        return False
    return "(built-in)" in str(sys.modules.get(name, ""))


def path_to_import(module_name: str) -> str | None:
    """Return the file path for an imported module.

    Args:
        module_name: The module name to import.

    Returns:
        The path to the imported module, or None if unavailable.
    """
    try:
        module = importlib.import_module(module_name)
    except (ImportError, ModuleNotFoundError) as e:
        logger.debug(f"Could not import '{module_name}': {e}")
        return None

    if module is None:
        return None

    path_to_file = getattr(module, "__file__", None)
    if path_to_file is None:
        return None
    if ".egg/" in path_to_file:
        return path_to_file.split(".egg/")[0] + ".egg"
    return path_to_file


def show_module_path(path: str) -> None:
    """Display file details for a module path using ls -ld.

    Args:
        path: The filesystem path to display.
    """
    result = subprocess.run(
        ["ls", "-ld", path],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.returncode:
        logger.warning(f"ls failed for '{path}': {result.stderr.strip()}")


def find_module(name: str) -> int:
    """Locate and display a Python module by name.

    Args:
        name: The module or package name to find.

    Returns:
        0 if found, 1 if not found.
    """
    if built_in(name):
        print(f"builtin {name}")
        return 0

    path = path_to_import(name)
    if path:
        show_module_path(path)
        return 0

    logger.warning(f"Module '{name}' not found.")
    return 1


def main(argv: list[str] | None = None) -> int:
    """Locate Python modules and packages.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(
        description="Locate Python modules and packages by name (like 'which' for Python).",
    )
    parser.add_argument(
        "modules",
        nargs="+",
        help="Module or package names to locate",
    )
    parser.add_argument(
        "--log-level",
        default="WARNING",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging level (default: WARNING)",
    )
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format="%(levelname)s: %(message)s",
    )
    logger.debug(f"Arguments: {vars(args)}")

    result = 0
    for name in args.modules:
        result |= find_module(name)
    return result


if __name__ == "__main__":
    sys.exit(main())
