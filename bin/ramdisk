#!/usr/bin/env python3
"""Create a RAM disk on macOS or Linux.

Creates a temporary RAM-backed filesystem. On macOS, uses hdiutil/diskutil
to create an HFS+ volume. On Linux, mounts a ramfs at the specified path.

Testing:
    macOS:
        python3 bin/ramdisk --name TestDisk --megabytes 64

    Linux:
        sudo python3 bin/ramdisk --name /mnt/ramdisk --megabytes 64

    Use --help to see all options.
"""

import argparse
import logging
import subprocess
import sys

logger = logging.getLogger(__name__)


def create_darwin_ramdisk(
    name: str = "", megabytes: int = 0, gigabytes: int = 0
) -> int:
    """Create a RAM disk on macOS using hdiutil and diskutil.

    Args:
        name: Volume name for the RAM disk.
        megabytes: Size in megabytes (mutually exclusive with gigabytes).
        gigabytes: Size in gigabytes (mutually exclusive with megabytes).

    Returns:
        Exit status code.
    """
    if not name:
        raise ValueError("name is required")

    blocks = megabytes * 2048 if megabytes else gigabytes * 1024 * 2048

    logger.info(f"Creating macOS RAM disk '{name}' ({blocks} blocks)...")
    try:
        result = subprocess.run(
            ["hdiutil", "attach", "-nomount", f"ram://{blocks}"],
            capture_output=True,
            text=True,
            check=True,
        )
        raw_volume = result.stdout.strip()
        logger.info(f"Attached device: {raw_volume}")

        subprocess.run(
            ["diskutil", "erasevolume", "HFS+", name, raw_volume],
            capture_output=True,
            text=True,
            check=True,
        )
        logger.info(f"RAM disk '{name}' created successfully.")
    except subprocess.CalledProcessError as e:
        logger.error(f"Failed to create RAM disk: {e.stderr.strip() or e}")
        return 1
    return 0


def create_linux_ramdisk(name: str = "", megabytes: int = 0, gigabytes: int = 0) -> int:
    """Create a RAM disk on Linux by mounting ramfs at a path.

    Args:
        name: Mount point path for the RAM disk.
        megabytes: Size in megabytes (mutually exclusive with gigabytes).
        gigabytes: Size in gigabytes (mutually exclusive with megabytes).

    Returns:
        Exit status code.
    """
    if not name:
        raise ValueError("name is required")

    import os

    if not os.path.isdir(name):
        logger.error(f"'{name}' is not a directory. Create it first.")
        return 1

    size = f"size={megabytes}m" if megabytes else f"size={gigabytes}g"

    logger.info(f"Mounting ramfs at '{name}' ({size})...")
    try:
        subprocess.run(
            ["mount", "-t", "ramfs", "-o", size, "ramfs", name],
            capture_output=True,
            text=True,
            check=True,
        )
        logger.info(f"RAM disk mounted at '{name}'.")
    except subprocess.CalledProcessError as e:
        logger.error(f"Failed to mount RAM disk: {e.stderr.strip() or e}")
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    """Create a RAM disk on the current platform.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(description="Create a RAM disk on macOS or Linux.")
    parser.add_argument(
        "--name",
        required=True,
        help="Volume name (macOS) or mount point path (Linux)",
    )

    size_group = parser.add_mutually_exclusive_group(required=True)
    size_group.add_argument(
        "--megabytes",
        type=int,
        help="Size of RAM disk in megabytes",
    )
    size_group.add_argument(
        "--gigabytes",
        type=int,
        help="Size of RAM disk in gigabytes",
    )

    parser.add_argument(
        "--log-level",
        default="INFO",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging level (default: INFO)",
    )

    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format="%(levelname)s: %(message)s",
    )
    logger.debug(f"Arguments: {vars(args)}")

    if sys.platform.startswith("darwin"):
        return create_darwin_ramdisk(
            name=args.name,
            megabytes=args.megabytes or 0,
            gigabytes=args.gigabytes or 0,
        )
    elif sys.platform.startswith("linux"):
        return create_linux_ramdisk(
            name=args.name,
            megabytes=args.megabytes or 0,
            gigabytes=args.gigabytes or 0,
        )
    else:
        logger.error(f"Unsupported platform: {sys.platform}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
