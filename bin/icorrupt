#!/usr/bin/env python3
"""Add random combining diacritics to text, making it look corrupted.

Adds multiple Unicode combining marks to each character, producing
the "Zalgo text" effect.

Original source: https://gist.github.com/twirrim/b87d08a2436437c8ff97a65877586182

Testing:
    python3 bin/icorrupt "hello world"
    echo "test" | python3 bin/icorrupt
"""

import argparse
import random
import sys

# Unicode combining diacritical marks (U+0300 to U+036F)
DIACRITICS = [chr(c) for c in range(0x0300, 0x0370)]


def corrupt_letter(letter: str, intensity: int = 10) -> str:
    """Add random diacritics to a single character.

    Args:
        letter: The character to corrupt.
        intensity: Number of diacritics to add (default: 10).

    Returns:
        The character with combining marks appended.
    """
    if not letter or letter.isspace():
        return letter
    marks = random.sample(DIACRITICS, k=min(intensity, len(DIACRITICS)))
    return letter + "".join(marks)


def corrupt_text(text: str, intensity: int = 10) -> str:
    """Add random diacritics to every character in text.

    Args:
        text: The input text to corrupt.
        intensity: Number of diacritics per character (default: 10).

    Returns:
        The corrupted text string.
    """
    if not text:
        return ""
    return "".join(corrupt_letter(c, intensity=intensity) for c in text)


def main(argv: list[str] | None = None) -> int:
    """Corrupt text with combining diacritical marks.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(
        description="Add random combining diacritics to text (Zalgo text effect).",
    )
    parser.add_argument(
        "text",
        nargs="?",
        default=None,
        help="Text to corrupt (reads stdin if not provided)",
    )
    parser.add_argument(
        "--intensity",
        type=int,
        default=10,
        help="Number of diacritics per character (default: 10)",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=None,
        help="Random seed for reproducible output",
    )
    args = parser.parse_args(argv)

    if args.seed is not None:
        random.seed(args.seed)

    if args.text is not None:
        text = args.text
    elif not sys.stdin.isatty():
        text = sys.stdin.read().rstrip("\n")
    else:
        parser.error("No text provided. Pass as argument or pipe via stdin.")
        return 1  # unreachable, but satisfies type checker

    print(corrupt_text(text, intensity=args.intensity))
    return 0


if __name__ == "__main__":
    sys.exit(main())
