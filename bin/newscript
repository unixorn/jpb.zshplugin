#!/usr/bin/env python3
"""Generate new script files from templates.

Creates new bash, python, or ruby scripts from built-in templates,
sets them executable, and populates a copyright year placeholder.

Copyright 2016-2026 Joe Block <jpb@unixorn.net>

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.

Testing:
    python3 bin/newscript --help
    python3 bin/newscript --dry-run --script-type bash my-tool
    python3 bin/newscript --dry-run --script-type python my-tool
    python3 bin/newscript --dry-run --script-type ruby my-tool
    python3 bin/newscript --script-type python /tmp/test-script
"""

import argparse
import datetime
import logging
import os
import stat
import sys
from pathlib import Path

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Templates
# ---------------------------------------------------------------------------

BASH_TEMPLATE = """#!/usr/bin/env bash
#
# This base script is MIT licensed so you can base your
# own work on it.
#
# {name} script skeleton
#
# Copyright {year}, {author} <{email}>

set -o pipefail
if [[ -n "$DEBUG" ]]; then
  # shellcheck disable=SC2086
  if [[ "$(echo $DEBUG | tr '[:upper:]' '[:lower:]')" == "verbose" ]]; then
    set -x
  fi
fi

function echo-stderr() {{
  printf '%s\\n' "$1" >&2  ## Send message to stderr. Exclude >&2 if you don't want it that way.
}}

function debug() {{
  if [[ -n "$DEBUG" ]]; then
    echo-stderr "$@"
  fi
}}

function verbose() {{
  if [[ -n "$VERBOSE" ]]; then
    echo "$@"
  fi
}}

function fail() {{
  echo-stderr "$1"
  exit "${{2-1}}"  ## Return a code specified by $2 or 1 by default.
}}

function has() {{
  # Check if a command is in $PATH
  which "$@" > /dev/null 2>&1
}}

# on_exit and add_on_exit from http://www.linuxjournal.com/content/use-bash-trap-statement-cleanup-temporary-files

# Usage:
#   add_on_exit rm -f /tmp/foo
#   add_on_exit echo "I am exiting"
#   tempfile=$(mktemp)
#   add_on_exit rm -f "$tempfile"

function on_exit()
{{
  for i in "${{on_exit_items[@]}}"
  do
    # shellcheck disable=SC2086
    eval $i
  done
}}

function add_on_exit()
{{
  local n=${{#on_exit_items[*]}}
  # shellcheck disable=SC2004
  on_exit_items[$n]="$*"
  if [[ $n -eq 0 ]]; then
    trap on_exit EXIT
  fi
}}

# Set up a working scratch directory
SCRATCH_D=$(mktemp -d)

if [[ ! "$SCRATCH_D" || ! -d "$SCRATCH_D" ]]; then
  echo "Could not create temp dir"
  exit 1
fi

add_on_exit rm -rf "$SCRATCH_D"

function get-default-settings() {{
  # Make it easy to override settings from CLI or by setting an
  # environment variable
  A_BOOL_SETTING=${{A_BOOL_SETTING:-'false'}}
  A_PATH_TO_A_FILE=${{A_PATH_TO_A_FILE:-'/path/to/file'}}
  STALE_BASH_TREATMENT=warning # set to 'failure' if the script won't work on stale bash
}}

function only-run-on() {{
  # shellcheck disable=SC2086
  if [[ "$(uname -s | tr '[:upper:]' '[:lower:]')" != "$(echo $1 | tr '[:upper:]' '[:lower:]')" ]]; then
    fail "This script only runs on $1, this machine is running $(uname -s)"
  else
    debug "OS ($(uname -s)) is valid..."
  fi
}}

function check-dependency() {{
  if ! (builtin command -V "$1" >/dev/null 2>&1); then
    fail "Missing dependency: can't find $1 in your PATH"
  fi
}}

function check-dependencies() {{
  debug "Checking dependencies..."
  # shellcheck disable=SC2041
  # Placeholders for whatever programs you really need
  for dep in "$@"
  do
    if ! has "$dep"; then
      fail "Can't find $dep in your $PATH"
    else
      debug "- Found $dep"
    fi
  done
}}

function approve() {{
  # $1 = prompt for user, or Continue?
  # $2 = message for non approved
  local prompt
  local reject_message
  prompt=${{1-'Ok to continue?'}}
  reject_message=${{2-'Exiting...'}}
  echo -n "$prompt [yes/NO]"
  read -r answer
  # shellcheck disable=SC2086
  if [[ ! "$(echo $answer | tr '[:upper:]' '[:lower:]')" == "yes" ]]; then
    fail "$reject_message"
  fi
}}

function check_bash_version() {{
  if [[ "${{BASH_VERSINFO[0]}}" == "3" ]]; then
    echo "You are running a very old version of bash.  Please upgrade to the"
    echo "latest version."
    echo
    echo "If you are on macOS, please use homebrew to install the latest GPL'd"
    echo "version of bash with the following command:"
    echo
    echo "brew install bash"
    echo
    if [[ "${{STALE_BASH_TREATMENT}}" == 'failure' ]]; then
      exit 1
    fi
  fi
  if [[ "${{BASH_VERSINFO[0]}}" -lt "5" ]]; then
    echo "Please make sure you are running v5 or greater of bash"
    exit 1
  fi
}}

function my-name() {{
  basename "$0"
}}

function usage() {{
  echo "Usage: $(my-name) ARG ARG"
}}

function path-exists() {{
  local file="${{1}}"
  [[ -s "${{file}}" ]] || fail "$1 is not valid"
  [[ -d "${{file}}" ]] && return
  [[ -f "${{file}}" ]] && return
  fail "$1 is not a directory or file"
}}

function pingable() {{
  if ! ping -c 5 $@ > /dev/null 2>&1; then
    debug "Could not ping $@"
    return 1
  else
    return 0
  fi
}}

# If you need to restrict to a specific os, use
# only-run-on Darwin
# or
# only-run-on Linux

# Placeholders for your script's real dependencies
check-dependencies bash cat
get-default-settings

# parse arguments

while :
do
  if [[ $# == 0 ]]; then
    break
  fi
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --fail-if-bash-stale)
      STALE_BASH_TREATMENT=failure
      shift
      ;;
    --set-a-bool-to-true)
      A_BOOL_SETTING='true'
      shift
      ;;
    --set-a-value)
      shift
      A_PATH_TO_A_FILE="$1"
      shift
      ;;
    -- )
      shift;
      break
      ;;
    *)
      echo-stderr "Unexpected option: $1"
      usage
      fail "Invalid CLI argument: '$1'"
      ;;
  esac
done

check_bash_version
"""

PYTHON_TEMPLATE = '''#!/usr/bin/env python3
"""{name} - description of what this script does.

Copyright {year}, {author} <{email}>
License: MIT
"""

import argparse
import logging
import sys

logger = logging.getLogger(__name__)


def main(argv: list[str] | None = None) -> int:
    """Main entry point.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(description="{name}")
    parser.add_argument(
        "--log-level",
        default="INFO",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging level (default: INFO)",
    )
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format="%(levelname)s: %(message)s",
    )
    logger.debug(f"Arguments: {{vars(args)}}")

    # Your code here

    return 0


if __name__ == "__main__":
    sys.exit(main())
'''

RUBY_TEMPLATE = """#!/usr/bin/env ruby
#
# Script skeleton
#
# Copyright {year}, {author} <{email}>

require 'optimist'
require 'logger'

def setup_logging(level)
  logger = Logger.new(STDOUT)
  case level.upcase
  when 'DEBUG'
    logger.level = Logger::DEBUG
  when 'ERROR'
    logger.level = Logger::ERROR
  when 'FATAL'
    logger.level = Logger::FATAL
  when 'INFO'
    logger.level = Logger::INFO
  when 'WARN'
    logger.level = Logger::WARN
  end
  logger.formatter = proc do |severity, datetime, progname, msg|
    date_format = datetime.strftime("%Y-%m-%d %H:%M:%S")
    if severity == "INFO" or severity == "WARN"
      "[#{{date_format}}] #{{severity}}  (#{{progname}}): #{{msg}}\\n"
    else
      "[#{{date_format}}] #{{severity}} (#{{progname}}): #{{msg}}\\n"
    end
  end
  return logger
end

def main
  opts = Optimist::options do
    version "{name} 0.1 (c) {year} {author} <{email}>"
    banner <<-EOS
  {name}

  Usage:
         {name} [options]
  where [options] are:
  EOS

    opt :debug, "Set debug level", :default => 0
    opt :log_level, "Set log level", :default => "INFO", :type => String
  end

  valid_levels = ['DEBUG', 'ERROR', 'FATAL', 'INFO', 'WARN']
  Optimist::die :log_level, "#{{opts[:log_level]}} must be in #{{valid_levels}}" unless valid_levels.include?(opts[:log_level].upcase)

  logger = setup_logging(opts[:log_level])
  logger.info("Starting {name}")

  # Your code here

end

main
"""

TEMPLATES: dict[str, str] = {
    "bash": BASH_TEMPLATE,
    "python": PYTHON_TEMPLATE,
    "ruby": RUBY_TEMPLATE,
}


# ---------------------------------------------------------------------------
# Core logic
# ---------------------------------------------------------------------------


def clean_name(name: str) -> str:
    """Sanitize a file name by replacing spaces with underscores.

    Args:
        name: The raw file name.

    Returns:
        The sanitized file name.
    """
    if not name:
        return name
    return name.replace(" ", "_")


def render_template(
    script_type: str,
    name: str,
    author: str = "Your Name",
    email: str = "yourname@yourdomain.com",
) -> str:
    """Render a script template with name, year, author, and email substitutions.

    Args:
        script_type: One of 'bash', 'python', or 'ruby'.
        name: The script name to embed in the template.
        author: Author name for the copyright line.
        email: Author email for the copyright line.

    Returns:
        The rendered template string.
    """
    year = datetime.datetime.now(tz=datetime.timezone.utc).year
    template = TEMPLATES[script_type]
    return template.format(name=name, year=year, author=author, email=email)


def write_script(path: Path, content: str, dry_run: bool = False) -> int:
    """Write a script file and make it executable.

    Args:
        path: Destination path for the new script.
        content: The rendered template content.
        dry_run: If True, print to stdout instead of writing.

    Returns:
        0 on success, 1 on failure.
    """
    if dry_run:
        logger.info(f"Would write to: {path}")
        print(content)
        return 0

    if path.exists():
        logger.error(f"File already exists: {path}. Refusing to overwrite.")
        return 1

    try:
        path.write_text(content, encoding="utf-8")
        os.chmod(
            path,
            stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH,
        )  # 755
        logger.info(f"Created: {path}")
    except OSError as e:
        logger.error(f"Failed to write {path}: {e}")
        return 1

    return 0


def main(argv: list[str] | None = None) -> int:
    """Generate new script files from templates.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(
        description="Generate new script files from built-in templates.",
    )
    parser.add_argument(
        "names",
        nargs="+",
        help="File names for the new scripts",
    )
    parser.add_argument(
        "-s",
        "--script-type",
        choices=list(TEMPLATES.keys()),
        default="bash",
        help="Template language (default: bash)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the template to stdout without writing a file",
    )
    parser.add_argument(
        "--author",
        default=os.environ.get("AUTHOR", "Your Name"),
        help="Author name for the copyright line (default: $AUTHOR or 'Your Name')",
    )
    parser.add_argument(
        "--email",
        default=os.environ.get("EMAIL", "yourname@yourdomain.com"),
        help="Author email for the copyright line (default: $EMAIL or 'yourname@yourdomain.com')",
    )
    parser.add_argument(
        "--log-level",
        default="INFO",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging level (default: INFO)",
    )
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format="%(levelname)s: %(message)s",
    )
    logger.debug(f"Arguments: {vars(args)}")

    result = 0
    for raw_name in args.names:
        name = clean_name(raw_name)
        path = Path(name)
        basename = path.stem
        content = render_template(
            script_type=args.script_type,
            name=basename,
            author=args.author,
            email=args.email,
        )
        result |= write_script(path=path, content=content, dry_run=args.dry_run)

    return result


if __name__ == "__main__":
    sys.exit(main())
