#!/usr/bin/env python3
"""HTTP server that reflects incoming requests back to the console.

Echoes the request method, path, headers, and body for GET, POST, PUT,
and DELETE requests. Useful for debugging webhooks and API clients.

Testing:
    Start the server:
        python3 bin/http-reflect --port 9999

    In another terminal:
        curl http://localhost:9999/hello?foo=bar
        curl -X POST -d '{"key":"value"}' -H "Content-Type: application/json" http://localhost:9999/api/test

    Request details appear in the server terminal. Ctrl-C to stop.
"""

import argparse
import logging
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

logger = logging.getLogger(__name__)


class RequestHandler(BaseHTTPRequestHandler):
    """Handler that logs request details and responds with 200."""

    def do_GET(self) -> None:
        """Handle GET requests."""
        logger.info("\n----- Request Start ----->")
        logger.info(f"GET {self.path}")
        logger.info(f"{self.headers}")
        logger.info("<----- Request End -----\n")

        self.send_response(200)
        self.send_header("Set-Cookie", "foo=bar")
        self.end_headers()

    def do_POST(self) -> None:
        """Handle POST requests."""
        content_length = self.headers.get("Content-Length")
        length = int(content_length) if content_length else 0

        body = self.rfile.read(length).decode("utf-8") if length else ""

        logger.info("\n----- Request Start ----->")
        logger.info(f"POST {self.path}")
        logger.info(f"{self.headers}")
        if body:
            logger.info(f"{body}")
        logger.info("<----- Request End -----\n")

        self.send_response(200)
        self.end_headers()

    do_PUT = do_POST
    do_DELETE = do_GET


def main(argv: list[str] | None = None) -> int:
    """Start the HTTP reflection server.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(
        description="HTTP server that echoes incoming requests to the console."
    )
    parser.add_argument(
        "--port",
        type=int,
        default=8080,
        help="Port to listen on (default: 8080)",
    )
    parser.add_argument(
        "--bind",
        default="",
        help="Address to bind to (default: all interfaces)",
    )
    parser.add_argument(
        "--log-level",
        default="INFO",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging level (default: INFO)",
    )
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format="%(message)s",
    )

    server = HTTPServer((args.bind, args.port), RequestHandler)
    logger.info(f"Listening on {args.bind or 'localhost'}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        logger.info("\nShutting down.")
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
