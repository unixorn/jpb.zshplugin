#!/usr/bin/env python3
"""Convert JSON to YAML.

Reads JSON from a file or stdin and outputs YAML to stdout.

Copyright 2022-2026, Joe Block <jpb@unixorn.net>
License: Apache 2.0

Testing:
    echo '{"foo": "bar"}' | python3 bin/json-to-yaml
    python3 bin/json-to-yaml config.json
"""

import argparse
import json
import sys

try:
    import yaml
except ImportError:
    print(
        "Error: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr
    )
    sys.exit(1)


def convert_json_to_yaml(input_stream: object, default_flow_style: bool = False) -> str:
    """Convert a JSON input stream to a YAML string.

    Args:
        input_stream: A file-like object containing JSON data.
        default_flow_style: If True, use flow style for collections (default: False).

    Returns:
        The YAML string representation of the JSON input.
    """
    data = json.load(input_stream)
    return yaml.safe_dump(data, default_flow_style=default_flow_style)


def main(argv: list[str] | None = None) -> int:
    """Convert JSON input to YAML output.

    Args:
        argv: Command-line arguments. Defaults to sys.argv[1:].

    Returns:
        Exit status code.
    """
    parser = argparse.ArgumentParser(description="Convert JSON to YAML.")
    parser.add_argument(
        "file",
        nargs="?",
        default=None,
        help="JSON file to convert (reads stdin if not provided)",
    )
    parser.add_argument(
        "--flow",
        action="store_true",
        help="Use flow style for collections",
    )
    args = parser.parse_args(argv)

    try:
        if args.file:
            with open(args.file, encoding="utf-8") as f:
                output = convert_json_to_yaml(f, default_flow_style=args.flow)
        elif not sys.stdin.isatty():
            output = convert_json_to_yaml(sys.stdin, default_flow_style=args.flow)
        else:
            parser.error("No input provided. Pass a file or pipe JSON via stdin.")
            return 1
    except json.JSONDecodeError as e:
        print(f"Error: Invalid JSON input: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    print(output, end="")
    return 0


if __name__ == "__main__":
    sys.exit(main())
